{
  "name": "design-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview --host 0.0.0.0",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "build:wasm": "cd ../crates/design-wasm && wasm-pack build --target web --out-dir ../../web/generated/design-wasm --out-name design_wasm --release",
    "test:wasm-browser": "node scripts/wasm-browser-smoke.mjs",
    "test:editor-browser": "node scripts/editor-browser-smoke.mjs",
    "predev": "pnpm run build:wasm",
    "prebuild": "pnpm run build:wasm",
    "pretypecheck": "pnpm run build:wasm",
    "pretest": "pnpm run build:wasm"
  },
  "dependencies": {
    "nuxt": "3.17.5",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vue-tsc": "2.2.8",
    "vitest": "3.2.4"
  }
}
